# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/collabnotes

# Redis connection string
REDIS_URL=redis://localhost:6379

# HMAC signing key for access tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in the Google Cloud Console and the
# one the frontend used to obtain the auth code (SRS FR-2).
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/google/callback

# Token lifetimes (SRS FR-4 defaults: 15m access / 30d refresh)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Cross-instance Redis relay: "false" for a single API instance (saves hosted-Redis quota)
REDIS_RELAY=true

# Max "send me a code" requests per IP per 15 minutes (verification allows 3x). SRS §9.2 A07
AUTH_RATE_LIMIT_MAX=20

# --- Email sign-in (Resend) ---
# "console" prints codes to the server log (fine for local dev); "resend" really sends.
# ("outbox" is for the E2E suite and is refused when NODE_ENV=production.)
EMAIL_TRANSPORT=console
# Create at https://resend.com/api-keys. SECRET: set it in your host's dashboard, never commit it.
RESEND_API_KEY=
# Until you verify a domain in Resend, only onboarding@resend.dev works, and it can only
# deliver to the address you signed up to Resend with.
EMAIL_FROM=CollabNotes <onboarding@resend.dev>
# Emails per UTC day across everyone (Resend's free tier is 100/day) and seconds between codes per address
EMAIL_DAILY_LIMIT=90
OTP_RESEND_COOLDOWN_SECONDS=30

# Reverse proxies in front of the API (0 = none, e.g. local dev). Wrong values make per-IP
# rate limits key on your load balancer — or, if too high, on a spoofable header.
TRUST_PROXY=0

# Serve the built frontend (apps/web/dist) from the API process (single-service deploy)
SERVE_WEB=false

# Allowlisted frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# Snapshot compaction job interval, ms (default 10 min)
SNAPSHOT_INTERVAL_MS=600000

# API server port
PORT=4000

# Frontend build-time API/WS URLs
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000

# Google OAuth client id (public, safe to expose in the frontend build) and
# the redirect URI Google sends the browser back to — must match
# GOOGLE_REDIRECT_URI above and be registered in the Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/google/callback
